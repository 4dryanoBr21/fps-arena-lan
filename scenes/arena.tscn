[ext_resource type="PackedScene" path="res://scenes/target.tscn" id="1_target"]

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

uniform vec3 base_color = vec3(0.16, 0.17, 0.2);
uniform vec3 line_color = vec3(0.34, 0.36, 0.42);

varying vec3 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 grid = abs(fract(world_pos.xz - 0.5) - 0.5) / fwidth(world_pos.xz);
	float line = 1.0 - min(min(grid.x, grid.y), 1.0);
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 0.9;
}
"

